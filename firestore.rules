rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin = Firebase custom claim {admin: true}. Set it once with scripts/set-admin-claim.js.
    // Do NOT gate on an email address: login.js lets anyone register any username@tactical.store.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Catalog: public read, admin write. Account credentials (stock_items) are admin-only and
    // are never readable by shoppers.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      match /stock_items/{itemId} {
        allow read, write: if isAdmin();
      }
    }

    // Reserved for a server-side vault; closed to every client.
    match /inventory_vault/{vaultId} {
      allow read, write: if false;
    }

    // Customers can only file a pending order for themselves. Status, credentials and delivery
    // can only be set by an admin after the payment is verified.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.createdAt == request.time
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.keys().hasOnly([
             'orderNumber', 'orderId', 'productId', 'productName', 'productType',
             'quantity', 'unit', 'unitPrice', 'subtotal', 'discount', 'promoCode',
             'amount', 'finalPrice', 'paymentMethod', 'paymentProof',
             'buyerEmail', 'buyerContact', 'status', 'userEmail', 'userId', 'createdAt'
           ]);
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Promo codes can be looked up by exact code but not listed; usage counts are admin-managed.
    match /promo_codes/{code} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Public storefront settings (banner text, QR image, shop name). Secrets must NOT live here.
    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin PIN hash (UI lock only; the real gate is the admin claim above).
    match /system_settings/{docId} {
      allow read, write: if isAdmin();
    }

    // Payment-provider keys (SlipOK, TrueMoney): admin only.
    match /system_private/{docId} {
      allow read, write: if isAdmin();
    }

    // Wallet balances and top-up records can only change through an admin until a server verifies
    // payments. A browser must never be able to credit its own balance.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /topup_transactions/{txnId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
